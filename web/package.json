{
  "name": "hpgg-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "e2e": "VITE_DATA_DIR=tests/e2e-data VITE_OUT_DIR=dist-e2e vite build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^2.1.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
