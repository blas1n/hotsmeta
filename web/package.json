{
  "name": "hpgg-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-data.mjs && next dev -p 5173",
    "build": "node scripts/sync-data.mjs && tsc --noEmit && next build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "e2e": "DATA_DIR=tests/e2e-data NEXT_DIST_DIR=dist-e2e npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^2.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  }
}
