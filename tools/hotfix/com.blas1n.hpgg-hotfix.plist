<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hotfix watcher (#62). Runs from the bot's own clone ~/Works/hpgg-bot, never the dev checkout.
     Install: cp tools/hotfix/com.blas1n.hpgg-hotfix.plist ~/Library/LaunchAgents/ &&
              launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.blas1n.hpgg-hotfix.plist -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.blas1n.hpgg-hotfix</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/uv</string>
        <string>run</string>
        <string>--frozen</string>
        <string>python</string>
        <string>tools/hotfix_watch.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/blasin/Works/hpgg-bot</string>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/blasin/Library/Logs/hpgg-hotfix.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/blasin/Library/Logs/hpgg-hotfix.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
